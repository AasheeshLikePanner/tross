15:["$","$L20",null,{"textProps":{"fontFamily":"sans","fontSize":"small","fontStyle":"normal","fontWeight":"normal","lineHeight":"default","textAlign":"start","children":[[["$","$21","0",{"children":[null,"Founder and President of Cornell Hacking Club. We are a group dedicated to understanding, deconstructing, and ultimately breaking systems in order to advance computer and network security. Our goal is to create a space where Cornell students of all disciplines can gather to crack open complex networks, and create some of their own."]}],["$","$21","1",{"children":[["$","br",null,{}],""]}],["$","$21","2",{"children":[["$","br",null,{}],"We hold regular body meetings with over 120 students in attendance while also competing in CTFs and Bug Bounty programs as smaller teams."]}]]],"offsetTop":"2x","linkColorTokens":"$undefined","linkHoverDecoration":"underline","lineClamp":3,"hasShowMore":false,"expandButtonText":"more","shouldCollapseNewLines":false,"noopOverride":false},"bindingKey":{"$type":"proto.sdui.StateKey","value":"auto-binding-e8967420-6fd8-4be0-b3be-2e7d7a6f5213","namespace":"MemoryNamespace","isEncrypted":false,"key":{"$type":"proto.sdui.Key","value":{"$case":"id","id":"auto-binding-e8967420-6fd8-4be0-b3be-2e7d7a6f5213"}}},"expansionKey":"auto-binding-e8967420-6fd8-4be0-b3be-2e7d7a6f5213","expandButtonTextColorExpression":179,"maxLineCountExpression":2,"onShowMoreAction":{"actions":[{"$type":"proto.sdui.actions.core.SetState","value":{"isOptimistic":false,"state":{"$type":"proto.sdui.State","stateKey":"","value":{"$case":"stringValue","stringValue":"Expanded"},"isOptimistic":false,"key":{"$type":"proto.sdui.StateKey","value":"auto-binding-e8967420-6fd8-4be0-b3be-2e7d7a6f5213","namespace":"MemoryNamespace","isEncrypted":false,"key":{"$type":"proto.sdui.Key","value":{"$case":"id","id":"auto-binding-e8967420-6fd8-4be0-b3be-2e7d7a6f5213"}}}}}}]},"onShowLessAction":"$undefined","textColorExpression":"$undefined","viewTrackingSpecs":"$undefined","isExpandableText