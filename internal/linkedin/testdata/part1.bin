18:["$","$L20",null,{"textProps":{"fontFamily":"sans","fontSize":"small","fontStyle":"normal","fontWeight":"normal","lineHeight":"default","textAlign":"start","children":[[["$","$21","0",{"children":[null,"Founded a website as a platform to help facilitate student-to-student exchange. Serving as a campus only Craigslist,  campusexposure.com launched August 21st, 2015 to overwhelmingly positive support from the Cornell Community."]}],["$","$21","1",{"children":[["$","br",null,{}],""]}],["$","$21","2",{"children":[["$","br",null,{}],"News Articles:"]}],["$","$21","3",{"children":[["$","br",null,{}],"http://news.cornell.edu/essentials/2015/08/students-launch-cornell-only-craigslist"]}],["$","$21","4",{"children":[["$","br",null,{}],"http://cornellsun.com/blog/2015/08/27/students-create-new-online-marketplace/"]}],["$","$21","5",{"children":[["$","br",null,{}],"http://www.ithacaweek-ic.com/cornell-students-develop-online-marketplace-for-university-community/"]}],["$","$21","6",{"children":[["$","br",null,{}],""]}]]],"offsetTop":"2x","linkColorTokens":"$undefined","linkHoverDecoration":"underline","lineClamp":3,"hasShowMore":false,"expandButtonText":"more","shouldCollapseNewLines":false,"noopOverride":false},"bindingKey":{"$type":"proto.sdui.StateKey","value":"auto-binding-641ba723-4136-4836-9475-85edbc7deae2","namespace":"MemoryNamespace","isEncrypted":false,"key":{"$type":"proto.sdui.Key","value":{"$case":"id","id":"auto-binding-641ba723-4136-4836-9475-85edbc7deae2"}}},"expansionKey":"auto-binding-641ba723-4136-4836-9475-85edbc7deae2","expandButtonTextColorExpression":179,"maxLineCountExpression":2,"onShowMoreAction":{"actions":[{"$type":"proto.sdui.actions.core.SetState","value":{"isOptimistic":false,"state":{"$type":"proto.sdui.State","stateKey":"","value":{"$case":"stringValue","stringValue":"Expanded"},"isOptimistic":false,"key":{"$type":"proto.sdui.StateKey","value":"auto-binding-641ba723-4136-4836-9475-85edbc7deae2","namespace":"MemoryNamespace","isEncrypted":fal