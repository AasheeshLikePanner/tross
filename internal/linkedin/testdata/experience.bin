17:["$","$L32",null,{"textProps":{"fontFamily":"sans","fontSize":"small","fontStyle":"normal","fontWeight":"normal","lineHeight":"open","textAlign":"start","children":[[["$","$33","0",{"children":[null,"Tech-lead for two Integrity teams using ML to proactively identify the \"worst-of-the-worst\" content (suicides, murders, etc) on our family of apps with the goal of notifying local law enforcement as quickly as possible."]}],["$","$33","1",{"children":[["$","br",null,{}],""]}],["$","$33","2",{"children":[["$","br",null,{}],"Was promoted from junior to staff engineer in 3 years. Read about my journey here: https://www.developing.dev/p/new-grad-to-staff-at-meta-in-3-years"]}]]],"offsetTop":"1x","linkColorTokens":"$undefined","linkHoverDecoration":"underline","lineClamp":3,"hasShowMore":false,"expandButtonText":"more","shouldCollapseNewLines":false,"noopOverride":false},"bindingKey":{"$type":"proto.sdui.StateKey","value":"expandable_text_block_auto-component-e4e101f6-b0fb-4d13-8da9-50c05948c3de","namespace":"","isEncrypted":false,"key":{"$type":"proto.sdui.Key","value":{"$case":"id","id":"expandable_text_block_auto-component-e4e101f6-b0fb-4d13-8da9-50c05948c3de"}}},"expansionKey":"expandable_text_block_auto-component-e4e101f6-b0fb-4d13-8da9-50c05948c3de","expandButtonTextColorExpression":179,"maxLineCountExpression":2,"onShowMoreAction":{"actions":[{"$type":"proto.sdui.actions.core.SetState","value":{"isOptimistic":false,"state":{"$type":"proto.sdui.State","stateKey":"","value":{"$case":"stringValue","stringValue":"Expanded"},"isOptimistic":false,"key":{"$type":"proto.sdui.StateKey","value":"expandable_text_block_auto-component-e4e101f6-b0fb-4d13-8da9-50c05948c3de","namespace":"","isEncrypted":false,"key":{"$type":"proto.sdui.Key","value":{"$case":"id","id":"expandable_text_block_auto-component-e4e101f6-b0fb-4d13-8da9-50c05948c3de"}}}}}}]},"onShowLessAction":"$undefined","textColorExpression":"$undefined","viewTrackingSpecs":"$undefined","isExpandableTextV2Enabled":tru