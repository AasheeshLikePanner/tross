1d:["$","$L32",null,{"textProps":{"fontFamily":"sans","fontSize":"small","fontStyle":"normal","fontWeight":"normal","lineHeight":"open","textAlign":"start","children":[[["$","$33","0",{"children":[null,"We are a group dedicated to understanding, deconstructing, and ultimately breaking systems in order to advance computer and network security. Our goal is to create a space where Cornell students of all disciplines can gather to crack open complex networks, and create some of their own."]}],["$","$33","1",{"children":[["$","br",null,{}],""]}],["$","$33","2",{"children":[["$","br",null,{}],"As a team of 20 we compete in bi-weekly international hacking competitions known as CTFs (Capture the Flag). In doing so, we regularly place in the top 5% and are often one of the top 3 highest scoring American teams."]}]]],"offsetTop":"1x","linkColorTokens":"$undefined","linkHoverDecoration":"underline","lineClamp":3,"hasShowMore":false,"expandButtonText":"more","shouldCollapseNewLines":false,"noopOverride":false},"bindingKey":{"$type":"proto.sdui.StateKey","value":"expandable_text_block_auto-component-225ac265-365c-4f3c-8689-484557075755","namespace":"","isEncrypted":false,"key":{"$type":"proto.sdui.Key","value":{"$case":"id","id":"expandable_text_block_auto-component-225ac265-365c-4f3c-8689-484557075755"}}},"expansionKey":"expandable_text_block_auto-component-225ac265-365c-4f3c-8689-484557075755","expandButtonTextColorExpression":179,"maxLineCountExpression":2,"onShowMoreAction":{"actions":[{"$type":"proto.sdui.actions.core.SetState","value":{"isOptimistic":false,"state":{"$type":"proto.sdui.State","stateKey":"","value":{"$case":"stringValue","stringValue":"Expanded"},"isOptimistic":false,"key":{"$type":"proto.sdui.StateKey","value":"expandable_text_block_auto-component-225ac265-365c-4f3c-8689-484557075755","namespace":"","isEncrypted":false,"key":{"$type":"proto.sdui.Key","value":{"$case":"id","id":"expandable_text_block_auto-component-225ac265-365c-4f3c-8689-484557075755"}}}}}}